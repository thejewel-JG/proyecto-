# Entorno del servidor
NODE_ENV="development"
PORT=3001

# Clave de API de Gemini (Opcional para asistente IA Astra/Kabaly)
GEMINI_API_KEY="AIzaSy..."

# URL pública de la aplicación
APP_URL="http://localhost:3001"

# CONFIGURACIÓN DE BASE DE DATOS RELACIONAL
# Valores posibles para DB_CLIENT: "sqlite" (desarrollo local) o "mysql" (producción Hostinger)
DB_CLIENT="sqlite"

# Opciones para MySQL (cuando DB_CLIENT="mysql"):
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="u141101294_kabaly"
DB_PASSWORD="TU_PASSWORD_AQUI"
DB_NAME="u141101294_kabaly"

# CONFIGURACIÓN DE CORREO SALIENTE (SMTP)
# Opciones para Hostinger Webmail o Gmail:
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT=465
# SMTP_USER="contacto@kabaly.com"
# SMTP_PASS="tu_contraseña_smtp"
# SMTP_FROM_NAME="KABALY"
# SMTP_FROM_EMAIL="contacto@kabaly.com"

# CONFIGURACIÓN DE STRIPE CHECKOUT (MODO DE PRUEBAS O PRODUCCIÓN)
# Utilizar sk_test_... en pruebas o sk_live_... en producción real.
STRIPE_SECRET_KEY="sk_test_tu_clave_secreta_de_prueba"
STRIPE_WEBHOOK_SECRET="whsec_tu_secreto_de_firma_webhook"

# CONFIGURACIÓN DE ALMACENAMIENTO EN LA NUBE (CLOUDINARY CDN)
# Si se rellenan, las fotos y vídeos subidos irán directo a Cloudinary y liberarán el disco de Hostinger.
# Si se dejan vacíos, se guardarán automáticamente en la carpeta local /uploads.
CLOUDINARY_CLOUD_NAME="TU_CLOUD_NAME"
CLOUDINARY_API_KEY="TU_API_KEY"
CLOUDINARY_API_SECRET="TU_API_SECRET"



