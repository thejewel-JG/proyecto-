# Entorno del servidor
NODE_ENV="development"
PORT=3001

# Clave de API de Gemini (Opcional para asistente IA Astra/Kabaly)
GEMINI_API_KEY="AIzaSy..."

# URL pública de la aplicación
APP_URL="http://localhost:3001"

# CONFIGURACIÓN DE BASE DE DATOS RELACIONAL
# Valores posibles para DB_CLIENT: "sqlite" (desarrollo local) o "mysql" (producción Hostinger)
DB_CLIENT="sqlite"

# Opciones para MySQL (cuando DB_CLIENT="mysql"):
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="u141101294_kabaly"
DB_PASSWORD="TU_PASSWORD_AQUI"
DB_NAME="u141101294_kabaly"

# CONFIGURACIÓN DE CORREO SALIENTE (SMTP)
# Opciones para Hostinger Webmail o Gmail:
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT=465
# SMTP_USER="contacto@kabaly.com"
# SMTP_PASS="tu_contraseña_smtp"
# SMTP_FROM_NAME="KABALY"
# SMTP_FROM_EMAIL="contacto@kabaly.com"

# CONFIGURACIÓN DE STRIPE CHECKOUT (MODO DE PRUEBAS / TESTNET)
# Utilizar exclusivamente claves de prueba. No ingresar secretos reales en repositorios.
